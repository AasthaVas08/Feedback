# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-secret

# Database — SQLite (dev) or PostgreSQL (prod)
# Dev (default):
DATABASE_URL=sqlite:///feedback.db
# Prod example:
# DATABASE_URL=postgresql://user:pass@localhost:5432/feedback

# Email (Microsoft 365 Graph API)
MAIL_ENABLED=false
MAIL_SENDER_EMAIL=
MAIL_SENDER_NAME=Feedback Platform

# Microsoft 365 Graph API credentials (OAuth2 client credentials flow)
# Register an app in Azure AD → App registrations → New registration
# Grant "Mail.Send" application permission and admin consent
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=

# Base URL for form links in emails (no trailing slash)
APP_BASE_URL=http://localhost:5000

# Reward settings
DEFAULT_MAX_REWARD=100
DEFAULT_MIN_REWARD=10
